# Copie este arquivo para .env e preencha. O .env nunca vai para o Git.

# Chave própria do Gemini para este serviço (não use a mesma chave da API Java)
GEMINI_API_KEY=
# Modelo que escreve a solicitação. Vazio usa o mesmo padrão da API Java (gemini-3.5-flash)
GEMINI_MODELO=
# Quanto o modelo "pensa" antes de responder: minimal (padrão, mais rápido), low, medium, high ou padrao
GEMINI_RACIOCINIO=

# API Java do RootFix
JAVA_API_URL=https://rootfix-java.onrender.com

# Embeddings: gemini (padrão, cabe no Render) ou local (só na máquina, precisa do requirements-local.txt)
EMBEDDINGS_PROVEDOR=gemini
# Vazio usa o padrão do provedor: gemini-embedding-001 ou paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_MODELO=
# Só para o Gemini: tamanho dos vetores (768 é leve e recomendado pelo Google)
EMBEDDINGS_DIMENSOES=768

# Similaridade mínima para considerar que um serviço foi encontrado (definida na avaliação)
LIMIAR_SIMILARIDADE=

# Tempos máximos de espera, em segundos (o Render gratuito leva ~1 min para acordar)
TIMEOUT_JAVA_SEGUNDOS=
TIMEOUT_GEMINI_SEGUNDOS=

# Só para os scripts de teste de integração: conta de gestor de teste da API Java
GESTOR_TESTE_EMAIL=
GESTOR_TESTE_SENHA=
